{
    "rewrites": [
        {
            "source": "/api/embed",
            "destination": "/api/embed"
        },
        {
            "source": "/:channel/:user",
            "destination": "/api/embed"
        },
        {
            "source": "/:channel",
            "destination": "/api/embed"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}